{
  "name": "dsh-audio-cue",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "DSH 宿主插件：审批询问与一轮对话结束时播放声音提示。纯宿主半、零外部依赖。",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml"
  ],
  "dsh": {
    "id": "dsh-audio-cue",
    "name": "声音提示",
    "permissions": "读取宿主事件",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "runtime": ">=0.1.1-rc.1 <0.3.0"
    }
  },
  "dependencies": {},
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anne43983959/dsh-audio-cue.git"
  },
  "homepage": "https://github.com/anne43983959/dsh-audio-cue#readme",
  "bugs": {
    "url": "https://github.com/anne43983959/dsh-audio-cue/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "audio",
    "notification",
    "sound"
  ]
}
